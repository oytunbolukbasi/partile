# Copy to apps/web/.env. Never commit real values. Production values live in Railway (see DEPLOY.md).

# Public site origin: share links, e-mail links, OG cards, magic-link redirects.
NEXT_PUBLIC_SITE_URL=https://getpartile.com

# Database. Empty → local PGlite under ./.data/partile with migrations + sample plans.
# Set → Postgres over TLS (Neon in production). WARNING: pointing this at production means local writes go live.
# Migrations run at boot (DB_AUTO_MIGRATE=0 disables). SEED_SAMPLE=1 adds sample plans on a real database (demo only).
# PGSSL=1 forces TLS (remote hosts get TLS anyway). New migrations: `corepack pnpm --filter @partile/db generate`.
DATABASE_URL=

# Signs the session cookie. Required in production (openssl rand -hex 32); a dev-only fallback is used when empty.
AUTH_SECRET=

# E-mail (Resend). Empty key → no mail is sent and the sign-in code is shown on screen. With a key, the code is also shown outside production.
RESEND_API_KEY=
RESEND_FROM="partile <merhaba@getpartile.com>"

# Uploads (posters, album). Empty → ./.data/uploads. Production: /data/uploads on the Railway volume (set in the image).
UPLOAD_DIR=

# Hourly reminder cron: GET /api/cron/hatirlatma with "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Test only: fixed 6-digit sign-in code for demo@getpartile.com (no mail is sent to it). Remove before launch.
DEMO_LOGIN_CODE=
