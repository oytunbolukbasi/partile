# Public site origin (share links, OG cards)
NEXT_PUBLIC_SITE_URL=https://getpartile.com

# E-mail verification + announcements (Resend) — wired up after the screens are built
RESEND_API_KEY=
RESEND_FROM="partile <merhaba@getpartile.com>"

# Database: leave empty for local PGlite (file-backed Postgres in ./.data/partile, seeded with sample plans);
# set a Neon connection string in production. Run migrations with `pnpm --filter @partile/db generate` after schema changes.
DATABASE_URL=

# Signs the session cookie (any long random string). A dev-only fallback is used when empty.
AUTH_SECRET=

# Uploads (posters, album). Leave empty for local files under ./.data/uploads; production needs a blob store (see lib/storage.ts).
UPLOAD_DIR=
